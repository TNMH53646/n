end
esp_d = function(g)
    if g.Character then local h=g.Character:FindFirstChild('RoleESP'); if h then h:Destroy() end end
end
esp_e = function(g, h)
    if not g.Character then return end
    local i=g.Character:FindFirstChild('HumanoidRootPart'); if not i then return end
    local j=i:FindFirstChild('Box2D')
    if ESP_CUSTOMIZATION.Box2D then
        if not j then
            j=Instance.new('BillboardGui'); j.Name='Box2D'; j.AlwaysOnTop=true; j.Size=UDim2.new(4,0,5,0); j.StudsOffset=Vector3.new(0,0,0); j.Parent=i
            local k=Instance.new('Frame'); k.Name='BoxFrame'; k.BackgroundTransparency=1; k.Size=UDim2.new(1,0,1,0); k.BorderSizePixel=2; k.Parent=j
            local l=Instance.new('UIStroke'); l.Name='Stroke'; l.Thickness=2; l.Parent=k
        end
        local k=j:FindFirstChild('BoxFrame'); if k then local l=k:FindFirstChild('Stroke'); if l then l.Color=h end end
    else if j then j:Destroy() end end
end
