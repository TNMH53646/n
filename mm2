local function getPlayerList()
    local a = {}
    for b, c in ipairs(ps:GetPlayers()) do
        if c ~= p then table.insert(a, c.Name) end
    end
    if #a == 0 then return {'No players'} end
    return a
end

local function killSelectedPlayer()
    if selectedPlayerToKill == 'None' or selectedPlayerToKill == 'No players' then
        Library:Notify({ Title='No Player Selected', Desc='กรุณาเลือกผู้เล่นจาก Dropdown ก่อน', Duration=3 })
        return
    end
    local a = ps:FindFirstChild(selectedPlayerToKill)
    if not a or not a.Character or not a.Character:FindFirstChild('Head') then
        Library:Notify({ Title='Invalid Target', Desc='ไม่พบผู้เล่น หรือผู้เล่นเสียชีวิตแล้ว', Duration=3 })
        return
    end
    if not p then return end
    local b = p.Character
    if not b or not b.Parent then return end
    local c, d = RolesPlrName['Murderer'] == p, b:FindFirstChild('Knife')
    if not d then
        d = p.Backpack:FindFirstChild('Knife')
        if d then
            d.Parent = b
        else
            if c then
                Library:Notify({ Title='Waiting for Knife', Desc='รอมีดปรากฏ...', Duration=2 })
                if waitingForKnifeLoop then waitingForKnifeLoop = false end
                waitingForKnifeLoop = true
                task.spawn(function()
                    local e = waitingForKnifeLoop
                    while e and waitingForKnifeLoop do
                        task.wait(0.1)
                        if RolesPlrName['Murderer'] ~= p then
                            waitingForKnifeLoop = false
                            Library:Notify({ Title='Role Changed', Desc='ไม่ใช่ฆาตกรแล้ว หยุดรอ', Duration=2 })
                            return
                        end
                        local f = p.Character
                        if not f then waitingForKnifeLoop = false return end
                        local g = f:FindFirstChild('Knife') or p.Backpack:FindFirstChild('Knife')
                        if g then
                            if g.Parent == p.Backpack then g.Parent = f end
                            local h = ps:FindFirstChild(selectedPlayerToKill)
                            if h and h.Character and h.Character:FindFirstChild('Head') then
                                pcall(function()
                                    g.Events.KnifeStabbed:FireServer()
                                    g.Events.HandleTouched:FireServer(h.Character.Head)
                                end)
                                Library:Notify({ Title='Kill Selected', Desc='สังหาร '..selectedPlayerToKill..' แล้ว', Duration=2 })
                            end
                            waitingForKnifeLoop = false
                            return
                        end
                    end
                end)
                return
            else
                Library:Notify({ Title='No Knife', Desc='คุณต้องเป็นฆาตกรก่อน!', Duration=3 })
                return
            end
        end
    end
    pcall(function()
        d.Events.KnifeStabbed:FireServer()
        d.Events.HandleTouched:FireServer(a.Character.Head)
    end)
    Library:Notify({ Title='Kill Selected', Desc='พยายามสังหาร '..selectedPlayerToKill, Duration=2 })
end

