    for a, b in pairs(killEffectConnections) do if b then b:Disconnect() end end
    killEffectConnections = {}
    if not killEffectEnabled then return end
    for a, b in pairs(ps:GetPlayers()) do
        if b ~= p then
            if b.Character then
                local c = b.Character:FindFirstChild('Humanoid')
                if c then
                    local d = c.Died:Connect(function()
                        if b.Character and b.Character:FindFirstChild('HumanoidRootPart') then
                            createKillEffect(b.Character, b.Character.HumanoidRootPart.CFrame)
