local function enableNoclip()
    if noclipConnection then return end
    noclipConnection=RunService.Stepped:Connect(function()
        if isFarmingCoins and p.Character then
            for g, h in pairs(p.Character:GetDescendants()) do if h:IsA('BasePart') then h.CanCollide=false end end
        end
    end)
end

local function startFarming()
    if not p.Character or not p.Character:FindFirstChild('HumanoidRootPart') then return end
    if p:GetAttribute('Alive')~=true then return end
    local g,h=p.Character.HumanoidRootPart, p.Character:FindFirstChild('Humanoid')
    addFarmGravity(); originalPartProperties={}
    for i, j in pairs(p.Character:GetDescendants()) do if j:IsA('BasePart') then originalPartProperties[j]={CanCollide=j.CanCollide,Massless=j.Massless} end end
    g.CFrame=g.CFrame-Vector3.new(0,2.5,0); g.CFrame=g.CFrame*CFrame.Angles(math.rad(90),0,0)
    if h then h.PlatformStand=true; h:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false); h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false) end
    farmingActive=true
end

local function stopFarming()
    farmingActive=false
    if currentTween then currentTween:Cancel(); currentTween=nil end
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection=nil end
    if p.Character then
        for g, h in pairs(originalPartProperties) do if g and g.Parent then g.CanCollide=h.CanCollide; g.Massless=h.Massless end end
        local g=p.Character:FindFirstChild('HumanoidRootPart')
        if g then g.Velocity=Vector3.new(0,0,0); g.RotVelocity=Vector3.new(0,0,0); g.CFrame=g.CFrame*CFrame.Angles(math.rad(-90),0,0); g.CFrame=g.CFrame+Vector3.new(0,2.5,0) end
        local h=p.Character:FindFirstChild('Humanoid')
        if h then h.PlatformStand=false; h:SetStateEnabled(Enum.HumanoidStateType.FallingDown,true); h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,true) end
    end
    originalPartProperties={}
end

