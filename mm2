local danceEnabled = false
local selectedDanceId = '127118661424463'
local currentDanceTrack = nil
local danceList = {
    ['Dance 1'] = '127118661424463',
    ['Dance 2'] = '82682811348660',
    ['Dance 3'] = '10714340543',
    ['Dance 4'] = '15609995579',
}

local function playDance()
    if not p.Character then return end
    if not selectedDanceId then return end
    local g = p.Character:FindFirstChildOfClass('Humanoid')
    if not g then return end
    local h = g:FindFirstChildOfClass('Animator')
    if not h then h = Instance.new('Animator'); h.Parent = g end
    if currentDanceTrack then
        pcall(function() currentDanceTrack:Stop() end)
        task.wait(0.1)
        pcall(function() currentDanceTrack:Destroy() end)
        currentDanceTrack = nil
    end
    task.wait(0.1)
    local i = Instance.new('Animation')
    i.AnimationId = 'rbxassetid://' .. tostring(selectedDanceId)
    pcall(function()
        currentDanceTrack = h:LoadAnimation(i)
        currentDanceTrack.Looped = true
        currentDanceTrack.Priority = Enum.AnimationPriority.Action
        currentDanceTrack:Play(0.1, 1, 1)
    end)
    i:Destroy()
end

local function stopDance()
    if currentDanceTrack then
        pcall(function() currentDanceTrack:Stop(); currentDanceTrack:Destroy() end)
        currentDanceTrack = nil
    end
end

p.CharacterAdded:Connect(function(g)
    g:WaitForChild('Humanoid'); task.wait(0.5)
    if danceEnabled then playDance() end
end)

