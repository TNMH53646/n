local function RandomLargeNumber(a, b)
    local c = b - a
    local d, e = math.random(0, 999999), math.random(0, 999)
    return a + (d + e*1000000) % c
end

local function InitializeVoidHide()
    if VoidHideOldIndex then return end
    local a = p.Character
    local b = a and a:FindFirstChild('HumanoidRootPart')
    if not b then return end
    VoidHideSpoofedProperties[b] = {}
    VoidHideOldIndex = hookmetamethod(game, '__index', function(c, d)
        if not checkcaller() and c and d then
            local e = VoidHideSpoofedProperties[c]
            if e and e[d] ~= nil then return e[d] end
        end
        return VoidHideOldIndex(c, d)
    end)
    VoidHideOldNewIndex = hookmetamethod(game, '__newindex', function(c, d, e)
        if not checkcaller() and c and d and e then
            local f = VoidHideSpoofedProperties[c]
            if f and d == 'CFrame' then
                f[d] = e
                if VoidHideSettings.Enabled then return end
            end
        end
        return VoidHideOldNewIndex(c, d, e)
    end)
end

local function VoidSpamFunction(a, b)
    if not VoidHideSettings.Enabled then VoidHideInVoid=false; VoidHideCurrentVoidPosition=nil; return end
    if not b or not b.Parent then return end
    local c = tick()
    if not VoidHideCurrentVoidPosition or (c-VoidHideLastVoidChange) >= VoidHideSettings.VoidChangeRate then
        if VoidHideSettings.RandomVoidPosition then
            local d = RandomLargeNumber(VoidHideSettings.VoidRangeMin, VoidHideSettings.VoidRangeMax)
            local e = RandomLargeNumber(VoidHideSettings.VoidHeightMin, VoidHideSettings.VoidHeightMax)
            local f = RandomLargeNumber(VoidHideSettings.VoidRangeMin, VoidHideSettings.VoidRangeMax)
            if math.random()>0.5 then d=-d end
            if math.random()>0.5 then f=-f end
            VoidHideCurrentVoidPosition = CFrame.new(d,e,f)
        else
            VoidHideCurrentVoidPosition = CFrame.new(VoidHideRealPosition.Position - Vector3.new(
                math.random(-VoidHideSettings.OffsetX,VoidHideSettings.OffsetX),
                VoidHideSettings.VoidHeight,
                math.random(-VoidHideSettings.OffsetZ,VoidHideSettings.OffsetZ)))
        end
        VoidHideLastVoidChange = c
    end
    if c-VoidHideLastVoid > VoidHideSettings.UpdateRate and not VoidHideInVoid then
        VoidHideInVoid = true
        task.delay(VoidHideSettings.UpdateRate, function() VoidHideLastVoid=c; VoidHideInVoid=false end)
    end
    if VoidHideInVoid then
        VoidHideRealPosition = VoidHideOldIndex(b, 'CFrame')
        local d = VoidHideOldIndex(b, 'Velocity')
        VoidHideSpoofedProperties[b]['CFrame'] = VoidHideRealPosition
        VoidHideOldNewIndex(b, 'CFrame', VoidHideCurrentVoidPosition)
        RunService.RenderStepped:Wait()
        VoidHideOldNewIndex(b, 'CFrame', VoidHideRealPosition)
        VoidHideOldNewIndex(b, 'Velocity', d)
    else
        if VoidHideSpoofedProperties[b]['CFrame'] then VoidHideSpoofedProperties[b]['CFrame'] = nil end
    end
end

