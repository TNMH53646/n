    c.Anchored = true
    c.CanCollide = false
    c.Transparency = 1
    c.Size = Vector3.new(0.1, 0.1, 0.1)
    c.Parent = a
    local d = Instance.new('Attachment')
    d.Name = 'BeamAttachment0'
    d.Parent = b
    local e = Instance.new('Attachment')
    e.Name = 'BeamAttachment1'
    e.Parent = c
    local f = Instance.new('Beam')
