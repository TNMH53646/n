local function disableGunClient(a)
    if not a then return end
    local b = a:FindFirstChild('GunClient')
    if b and b:IsA('LocalScript') and b.Enabled then
        b.Enabled = false
        disabledGunClients[a] = b
    end
end

local function enableGunClient(a)
    if not a then return end
    local b = disabledGunClients[a]
    if b and b:IsA('LocalScript') then
        b.Enabled = true
        disabledGunClients[a] = nil
    else
        local c = a:FindFirstChild('GunClient')
        if c and c:IsA('LocalScript') and not c.Enabled then c.Enabled = true end
    end
end

local function magicBulletShoot(a)
    if not a then return end
    local b = RolesPlrName['Murderer']
    if not b or not b.Character or not b.Character:FindFirstChild('HumanoidRootPart') then return end
    local c, d = b.Character.HumanoidRootPart, getPing()
    local e, f = (d/1000)*predictionMultiplier, c.Velocity
    local g = f.Magnitude
    local h = g < 1 and (c.Position + c.CFrame.LookVector*2) or (c.Position + f*((e)*(1+g/50)))
    local i = c.Position - c.CFrame.LookVector
    local n = a:FindFirstChild('Shoot')
    if n and n:IsA('RemoteEvent') then
        n:FireServer(CFrame.new(i.X,i.Y,i.Z), CFrame.new(h.X,h.Y,h.Z))
    end
end

local function setupMagicBulletTool(a)
    if not a or not a:IsA('Tool') then return end
    if magicBulletToolConnection then magicBulletToolConnection:Disconnect(); magicBulletToolConnection = nil end
    magicBulletToolConnection = a.Activated:Connect(function()
        if magicBulletEnabled then magicBulletShoot(a) end
    end)
end

local function enableMagicBullet()
    if p.Character then
        local a = p.Character:FindFirstChild('Gun')
        if a then disableGunClient(a); setupMagicBulletTool(a) end
    end
    if p.Backpack then
        local a = p.Backpack:FindFirstChild('Gun')
        if a then disableGunClient(a); setupMagicBulletTool(a) end
    end
end

local function stopGunMonitoring()
    for a, b in pairs(gunMonitorConnections) do if b then b:Disconnect() end end
    gunMonitorConnections = {}
end

local function disableMagicBullet()
    if magicBulletToolConnection then magicBulletToolConnection:Disconnect(); magicBulletToolConnection = nil end
    stopGunMonitoring()
    for a, b in pairs(disabledGunClients) do enableGunClient(a) end
    disabledGunClients = {}
end

local function monitorGunAppearance()
    local a = p.CharacterAdded:Connect(function(b)
        if not magicBulletEnabled then return end
        local c = b.ChildAdded:Connect(function(d)
            if d.Name == 'Gun' and d:IsA('Tool') and magicBulletEnabled then
                task.wait(0.1); disableGunClient(d); setupMagicBulletTool(d)
            end
        end)
        table.insert(gunMonitorConnections, c)
    end)
    table.insert(gunMonitorConnections, a)
    if p.Backpack then
        local b = p.Backpack.ChildAdded:Connect(function(c)
            if c.Name == 'Gun' and c:IsA('Tool') and magicBulletEnabled then
                task.wait(0.1); disableGunClient(c); setupMagicBulletTool(c)
            end
        end)
        table.insert(gunMonitorConnections, b)
    end
end
