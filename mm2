    if k:FindFirstChildOfClass('Humanoid') then l = k:FindFirstChildOfClass('Humanoid') end
    if l and l.RootPart then m = l.RootPart end
    if k:FindFirstChild('Head') then n = k.Head end
    if k:FindFirstChildOfClass('Accessory') then o = k:FindFirstChildOfClass('Accessory') end
    if o and o:FindFirstChild('Handle') then q = o.Handle end
    if h and i and j then
        if j.Velocity.Magnitude < 50 then getgenv().OldPos = j.CFrame end
        if l and l.Sit then return end
        if n then workspace.CurrentCamera.CameraSubject = n
        elseif q then workspace.CurrentCamera.CameraSubject = q
        elseif l and m then workspace.CurrentCamera.CameraSubject = l end
        if not k:FindFirstChildWhichIsA('BasePart') then return end
        local r = function(r, s, t)
            j.CFrame = CFrame.new(r.Position) * s * t
            h:SetPrimaryPartCFrame(CFrame.new(r.Position) * s * t)
            j.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
            j.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        end
        local s = function(s)
            local t, u, v = 2, tick(), 0
            repeat
                if j and l then
                    if s.Velocity.Magnitude < 50 then
                        v = v + 100
                        r(s, CFrame.new(0,1.5,0) + l.MoveDirection * s.Velocity.Magnitude/1.25, CFrame.Angles(math.rad(v),0,0)); task.wait()
                        r(s, CFrame.new(0,-1.5,0) + l.MoveDirection * s.Velocity.Magnitude/1.25, CFrame.Angles(math.rad(v),0,0)); task.wait()
                        r(s, CFrame.new(0,1.5,0) + l.MoveDirection * s.Velocity.Magnitude/1.25, CFrame.Angles(math.rad(v),0,0)); task.wait()
                        r(s, CFrame.new(0,-1.5,0) + l.MoveDirection * s.Velocity.Magnitude/1.25, CFrame.Angles(math.rad(v),0,0)); task.wait()
                        r(s, CFrame.new(0,1.5,0) + l.MoveDirection, CFrame.Angles(math.rad(v),0,0)); task.wait()
                        r(s, CFrame.new(0,-1.5,0) + l.MoveDirection, CFrame.Angles(math.rad(v),0,0)); task.wait()
                    else
                        r(s, CFrame.new(0,1.5,l.WalkSpeed), CFrame.Angles(math.rad(90),0,0)); task.wait()
                        r(s, CFrame.new(0,-1.5,-l.WalkSpeed), CFrame.Angles(0,0,0)); task.wait()
                        r(s, CFrame.new(0,1.5,l.WalkSpeed), CFrame.Angles(math.rad(90),0,0)); task.wait()
                        r(s, CFrame.new(0,-1.5,0), CFrame.Angles(math.rad(90),0,0)); task.wait()
                        r(s, CFrame.new(0,-1.5,0), CFrame.Angles(0,0,0)); task.wait()
                        r(s, CFrame.new(0,-1.5,0), CFrame.Angles(math.rad(90),0,0)); task.wait()
                        r(s, CFrame.new(0,-1.5,0), CFrame.Angles(0,0,0)); task.wait()
                    end
                end
            until u + t < tick() or not FlingActive
        end
        workspace.FallenPartsDestroyHeight = 0 / 0
        local t = Instance.new('BodyVelocity')
        t.Parent = j; t.Velocity = Vector3.new(0,0,0); t.MaxForce = Vector3.new(9e9,9e9,9e9)
        i:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        if m then s(m) elseif n then s(n) elseif q then s(q) end
        t:Destroy()
        i:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        workspace.CurrentCamera.CameraSubject = i
        if getgenv().OldPos then
            repeat
                j.CFrame = getgenv().OldPos * CFrame.new(0, 0.5, 0)
                h:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, 0.5, 0))
                i:ChangeState('GettingUp')
                for u, v in pairs(h:GetChildren()) do
                    if v:IsA('BasePart') then v.Velocity, v.RotVelocity = Vector3.new(), Vector3.new() end
                end
                task.wait()
            until (j.Position - getgenv().OldPos.p).Magnitude < 25
            workspace.FallenPartsDestroyHeight = getgenv().FPDH
        end
    end
end

