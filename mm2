        local l=Instance.new('Frame'); l.Name='AvatarFrame'; l.BackgroundColor3=Color3.new(1,1,1); l.Size=UDim2.new(0,40,0,40); l.Position=UDim2.new(0.5,-20,0,0); l.BorderSizePixel=2; l.Parent=k
