    local a = p.Character
    if a then
        local b = a:FindFirstChildOfClass('Tool')
        if b and originalGrip then b.Grip = originalGrip; originalGrip = nil end
    end
end

local function startToolSpin()
    stopToolSpin()
    if not toolSpinEnabled then return end
    local a, b = 0, 0
    toolSpinConnection = RunService.Heartbeat:Connect(function(c)
        local d = p.Character
        if not d then return end
        local e = d:FindFirstChildOfClass('Tool')
        if not e then return end
        if not originalGrip then originalGrip = e.Grip end
        b = b + c
        if toolSpinMode == '360° Forward' then
            a = a + (360 * toolSpinSpeed) * c
            if a >= 360 then a = a - 360 end
            e.Grip = originalGrip * CFrame.Angles(math.rad(a), 0, 0)
        elseif toolSpinMode == '360° Back' then
            a = a - (360 * toolSpinSpeed) * c
            if a <= -360 then a = a + 360 end
            e.Grip = originalGrip * CFrame.Angles(math.rad(a), 0, 0)
        elseif toolSpinMode == '360° Forward -> 360° Back' then
            local f = 2 / toolSpinSpeed
            local g = (b % f) / f
            local function easeBackInOut(h)
                local i = 1.70158 * 1.525; h = h * 2
                if h < 1 then return 0.5 * (h * h * ((i + 1) * h - i)) end
                h = h - 2; return 0.5 * (h * h * ((i + 1) * h + i) + 2)
            end
            local h = easeBackInOut(g)
            local i = math.sin(h * math.pi * 2) * 180
            e.Grip = originalGrip * CFrame.Angles(math.rad(i), 0, 0)
        end
    end)
end

