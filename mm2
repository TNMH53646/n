local function createKillEffect(a, b)
    if not killEffectEnabled or not a then return end
    local c = a:Clone()
    local d = c:FindFirstChild('HumanoidRootPart')
    if d then d.Transparency=1 end
    for e, f in pairs(c:GetDescendants()) do
        if f:IsA('BasePart') or f:IsA('MeshPart') then
            if f.Name=='HumanoidRootPart' then f.Transparency=1; f.Anchored=true; f.CanCollide=false; continue end
            f.Anchored=true; f.CanCollide=false; f.Material=Enum.Material.Neon; f.Color=killEffectColor; f.Transparency=0
            if f:IsA('MeshPart') then f.TextureID='' end
        end
        if f:IsA('SpecialMesh') then f.TextureId='' end
        if f:IsA('Decal') then if f.Name~='face' then f:Destroy() else f.Transparency=1 end end
        if f:IsA('Texture') then f:Destroy() end
        if f:IsA('Script') or f:IsA('LocalScript') or f:IsA('ModuleScript') then f:Destroy() end
        if f:IsA('Humanoid') or f:IsA('Tool') then f:Destroy() end
    end
    for g, h in pairs(c:GetDescendants()) do if h:IsA('Weld') or h:IsA('Motor6D') then h:Destroy() end end
    for g, h in pairs(c:GetDescendants()) do if h:IsA('BasePart') or h:IsA('MeshPart') then h.Anchored=true end end
    if c.PrimaryPart then c:SetPrimaryPartCFrame(b) elseif d then d.CFrame=b end
    c.Parent = workspace
    task.spawn(function()
        for j = 1, 60 do
            task.wait(2/60)
            for k, l in pairs(c:GetDescendants()) do
                if l:IsA('BasePart') or l:IsA('MeshPart') then l.Transparency=math.min(1, l.Transparency+1/60) end
            end
        end
        c:Destroy()
    end)
end

