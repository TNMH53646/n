        i=Instance.new('Highlight'); i.Name='RoleESP'; i.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        i.FillTransparency=0.5; i.OutlineTransparency=0; i.Parent=g.Character
    end
