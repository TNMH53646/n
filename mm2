TrackSection:Toggle({
    Title='Enable Relative Tween', Value=false,
    Callback=function(state)
        isTweeningRelative=state
        local myChar=p.Character; local myHRP=myChar and myChar:FindFirstChild('HumanoidRootPart')
        if not isTweeningRelative then
            if tempPlatform then tempPlatform:Destroy(); tempPlatform=nil end
            if myHRP then removeBodyVelocityTP(myHRP) end; return
        end
        task.spawn(function()
            while isTweeningRelative do
                local target=ps:FindFirstChild(selectedTPName)
                local curChar=p.Character; local curHRP=curChar and curChar:FindFirstChild('HumanoidRootPart')
                if target and target.Character and target.Character:FindFirstChild('HumanoidRootPart') and curHRP then
                    local tHRP=target.Character.HumanoidRootPart
                    local targetPos=getTargetOffsetPosition(tHRP, tweenDirection, tweenDistance)
                    local finalCF
                    if isAutoLooking then
                        local lookAt=Vector3.new(tHRP.Position.X,targetPos.Y,tHRP.Position.Z)
                        if (lookAt-targetPos).Magnitude>0.001 then finalCF=CFrame.lookAt(targetPos,lookAt) else finalCF=CFrame.new(targetPos) end
                    else finalCF=CFrame.new(targetPos)*(tHRP.CFrame-tHRP.CFrame.Position) end
                    updateTweenPlatform(targetPos); applyBodyVelocityTP(curHRP, targetPos)
                    local tw=TweenService:Create(curHRP, TweenInfo.new(0.15,Enum.EasingStyle.Linear), {CFrame=finalCF}); tw:Play()
                else if curHRP then removeBodyVelocityTP(curHRP) end end
                task.wait(0.15)
            end
        end)
    end,
})

