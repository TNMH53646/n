local function doFling(target, name)
    if FlingActive then return end
    if not target or not target.Parent then
        Library:Notify({ Title='Error', Desc='ไม่พบ '..name, Duration=3 }); return
    end
    FlingActive=true
    local j=UIElements.voidHideToggle and UIElements.voidHideToggle.GetValue and UIElements.voidHideToggle.GetValue() or false
    if j and UIElements.voidHideToggle.SetValue then UIElements.voidHideToggle.SetValue(false) end
    Library:Notify({ Title='Fling Started', Desc='Flinging: '..target.Name, Duration=3 })
    task.spawn(function()
        SkidFling(target); FlingActive=false
        if j and UIElements.voidHideToggle.SetValue then task.wait(0.5); UIElements.voidHideToggle.SetValue(true) end
        task.wait(0.1)
        if workspace.CurrentCamera and p.Character then workspace.CurrentCamera.CameraSubject=p.Character:FindFirstChildOfClass('Humanoid') end
    end)
end

