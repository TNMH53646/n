local function clearTextures()
    for a, b in ipairs(textureObjects) do pcall(function() b:Destroy() end) end
    textureObjects={}
    local a=game:GetService('MaterialService')
    for c, d in ipairs(Enum.Material:GetEnumItems()) do pcall(function() a:SetBaseMaterialOverride(d,'') end) end
end
local function applyTextures()
    clearTextures(); if not texturesEnabled then return end
    local a=texturethemes[selectedTextureTheme]; if not a then return end
    local b=game:GetService('MaterialService')
    for c, d in ipairs(a) do
        local e, f = d[1], d[2]
        if not f:find('rbxassetid://') and not f:find('http') then f='rbxassetid://'..f end
        pcall(function()
            local g=Instance.new('MaterialVariant'); g.Name='Texture_'..e; g.BaseMaterial=Enum.Material[e]
            g.ColorMap=f; g.NormalMap=f; g.RoughnessMap=f; g.MetalnessMap=f; g.StudsPerTile=5; g.Parent=b
            table.insert(textureObjects, g); b:SetBaseMaterialOverride(Enum.Material[e], g.Name)
        end)
    end
end

